{
  "name": "macvnc",
  "version": "1.0.0",
  "description": "A free, from-scratch VNC client for macOS Screen Sharing (RFB 003.889 / Apple auth)",
  "main": "src/main/index.js",
  "type": "module",
  "keywords": [
    "vnc",
    "rfb",
    "macos",
    "screen-sharing",
    "remote-desktop",
    "electron"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jazztong/macvnc.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "pako": "^2.1.0"
  },
  "build": {
    "appId": "com.jazztong.macvnc",
    "productName": "macvnc",
    "copyright": "Copyright (c) 2026 Jazz Tong",
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.md"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    }
  }
}
